#!/usr/bin/env bash
# Artwork resolution for the News bar plugin.
#
# Two jobs the QML side should not be doing itself:
#
#   1. Reading an article page to find its OpenGraph artwork. Pages are
#      routinely 400-500 KB; pulling that through XMLHttpRequest would park
#      half a megabyte of markup in the shell's JS heap per story.
#   2. Downloading artwork to disk. Qt's image cache is per-process and
#      in-memory, so without this every panel open re-fetches every picture
#      from the publisher -- and "clean the cache" would have nothing to clean.
#
# Every fetch is bounded in time and in bytes, and nothing is ever written
# outside the cache directory handed in on argv.
#
# Usage:
#   news-media feed  <feed-url>                            fetch a feed, bounded
#   news-media page  <cache-dir> <article-url> <item-id>   resolve + download
#   news-media image <cache-dir> <image-url>   <item-id>   download only
#   news-media list  <cache-dir>                           inventory the picture cache
#   news-media gc    <cache-dir> [path...]                  delete those files (or stdin)
#   news-media opml  <path>                                read a local OPML file, bounded
#   news-media pick                                        file chooser for an OPML file
#
# Emits one JSON object on stdout. Failure is reported in that JSON, not by
# exit status: a story with no picture is a normal outcome, not an error.

set -uo pipefail

readonly UA='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36'
# 1 MB. Generous on purpose: a plain article page puts its <head> in the first
# few KB and the read stops there, but a JS-heavy page can bury its meta tags
# behind hundreds of KB of inline script (a YouTube watch page keeps og:image at
# roughly byte 698,000). Pages smaller than the cap cost nothing extra.
readonly PAGE_MAX_BYTES=1048576
readonly IMAGE_MAX_BYTES=4194304    # 4 MB; a card is a few hundred px wide

# Encoded size is not decode size. A few hundred KB of highly compressible PNG
# can describe a 200 x 100000 canvas, which costs bytes to fetch and gigabytes
# to decode -- and the decode happens inside the long-lived shell. So the
# geometry is read from the header and capped too. Real lead artwork runs about
# 1-3 megapixels; 16 MP is five times the largest thing a publisher has any
# reason to serve, and 6000 px on a side refuses the pathological aspect ratios
# that make a small file expensive.
readonly IMAGE_MAX_DIM=6000
readonly IMAGE_MAX_PIXELS=16000000
readonly CONNECT_TIMEOUT=8
readonly TOTAL_TIMEOUT=20
readonly FEED_MAX_BYTES=4194304     # 4 MB; the largest feed tested against is ~80 KB
readonly OPML_MAX_BYTES=2097152     # 2 MB; an export of a few hundred feeds is ~100 KB

json_escape() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/ }
  s=${s//$'\r'/ }
  s=${s//$'\t'/ }
  printf '%s' "$s"
}

emit() { # emit ok id image video site artwork bytes error
  printf '{"ok":%s,"id":"%s","image":"%s","video":"%s","siteName":"%s","artwork":"%s","bytes":%s,"error":"%s"}\n' \
    "$1" "$(json_escape "$2")" "$(json_escape "$3")" "$(json_escape "$4")" \
    "$(json_escape "$5")" "$(json_escape "$6")" "${7:-0}" "$(json_escape "${8-}")"
}

# The cache directory is the only place this script may write. Resolving it and
# refusing anything outside is what keeps a crafted item id or a poisoned cache
# index from turning a delete into an arbitrary unlink.
resolve_cache_dir() {
  local dir=$1
  [[ -n $dir && $dir == /* ]] || return 1
  mkdir -p -- "$dir" 2>/dev/null || return 1
  CACHE_DIR=$(cd -- "$dir" && pwd -P) || return 1
  [[ -n $CACHE_DIR && $CACHE_DIR != "/" ]] || return 1
  return 0
}

# curl exits 23 when head closes the pipe early, which is the normal way this
# stops reading a large page. That is success here, not failure.
fetch_head() {
  local url=$1
  curl --silent --location --max-redirs 5 \
       --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TOTAL_TIMEOUT" \
       --user-agent "$UA" \
       --header 'Accept: text/html,application/xhtml+xml' \
       --proto '=http,https' \
       "$url" 2>/dev/null | head -c "$PAGE_MAX_BYTES"
}

# <meta property="og:image" content="..."> in any attribute order, with either
# quote style, and with property/name used interchangeably as publishers do.
meta_content() {
  local html=$1 key=$2
  printf '%s' "$html" \
    | tr '\n' ' ' \
    | grep -oiE "<meta[^>]*(property|name)[[:space:]]*=[[:space:]]*[\"']${key}[\"'][^>]*>|<meta[^>]*content[[:space:]]*=[^>]*(property|name)[[:space:]]*=[[:space:]]*[\"']${key}[\"'][^>]*>" \
    | head -n 1 \
    | grep -oiE "content[[:space:]]*=[[:space:]]*(\"[^\"]*\"|'[^']*')" \
    | head -n 1 \
    | sed -E "s/^content[[:space:]]*=[[:space:]]*[\"']//; s/[\"']$//"
}

# Entities survive in meta attributes constantly (&amp; in every query string).
unescape() {
  printf '%s' "${1-}" \
    | sed -e 's/&amp;/\&/g' -e 's/&#38;/\&/g' -e 's/&quot;/"/g' \
          -e 's/&#39;/'"'"'/g' -e 's/&apos;/'"'"'/g' -e 's/&lt;/</g' -e 's/&gt;/>/g'
}

absolutize() { # absolutize url base
  local u=${1-} base=${2-}
  [[ -z $u ]] && return 0
  case $u in
    http://*|https://*) printf '%s' "$u"; return 0 ;;
    //*)                printf 'https:%s' "$u"; return 0 ;;
  esac
  local origin=${base%%/*}
  origin=$(printf '%s' "$base" | grep -oE '^https?://[^/]+') || true
  [[ -z $origin ]] && return 0
  case $u in
    /*) printf '%s%s' "$origin" "$u" ;;
    *)  printf '%s/%s' "$origin" "$u" ;;
  esac
}

is_http_url() { [[ ${1-} =~ ^https?://[^[:space:]\"\'\<\>]+$ ]]; }

# Named by a hash of the source URL, so the same picture shared by two stories
# is downloaded once and re-requesting it after a cleanup lands on the same
# path. The extension comes from the bytes, never from the URL.
download_image() {
  local url=$1
  is_http_url "$url" || { printf ''; return 1; }

  local key tmp mime ext dest
  key=$(printf '%s' "$url" | sha1sum | cut -d' ' -f1)
  tmp="$CACHE_DIR/.tmp.$key.$$"

  curl --silent --location --max-redirs 5 \
       --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TOTAL_TIMEOUT" \
       --user-agent "$UA" \
       --header 'Accept: image/avif,image/webp,image/*' \
       --proto '=http,https' \
       --max-filesize "$IMAGE_MAX_BYTES" \
       --output "$tmp" "$url" 2>/dev/null

  [[ -s $tmp ]] || { rm -f -- "$tmp"; return 1; }

  # A server can answer an image request with anything at all. Trusting the
  # bytes rather than the URL keeps HTML error pages out of the picture cache.
  mime=$(file -b --mime-type -- "$tmp" 2>/dev/null)
  local coder
  case $mime in
    image/jpeg) ext=jpg;  coder=JPEG ;;
    image/png)  ext=png;  coder=PNG  ;;
    image/webp) ext=webp; coder=WEBP ;;
    image/gif)  ext=gif;  coder=GIF  ;;
    image/avif) ext=avif; coder=AVIF ;;
    *) rm -f -- "$tmp"; return 1 ;;
  esac

  if ! within_pixel_budget "$tmp" "$coder"; then
    rm -f -- "$tmp"
    return 1
  fi

  dest="$CACHE_DIR/$key.$ext"
  mv -f -- "$tmp" "$dest" 2>/dev/null || { rm -f -- "$tmp"; return 1; }
  chmod 600 -- "$dest" 2>/dev/null
  printf '%s' "$dest"
}

file_size() { stat -c%s -- "$1" 2>/dev/null || printf '0'; }

# Reads geometry from the image header and refuses anything that would decode
# into more pixels than a bar plugin has any business allocating.
#
# `-ping` stops after the header instead of decoding the image, and the coder is
# named explicitly from the already-sniffed MIME type so ImageMagick never
# guesses a format (and never picks a delegate) from file contents. The resource
# limits bound even that: header parsing of a malformed file cannot run away.
# Unreadable geometry fails closed -- a picture whose size cannot be established
# is not shown.
within_pixel_budget() {
  local path=$1 coder=$2 geometry w h
  geometry=$(identify -quiet -ping \
    -limit memory 32MiB -limit map 32MiB -limit disk 0 -limit thread 1 -limit time 5 \
    -format '%w %h\n' "$coder:$path" 2>/dev/null | head -n 1)
  [[ -n $geometry ]] || return 1

  w=${geometry%% *}
  h=${geometry##* }
  [[ $w =~ ^[0-9]+$ && $h =~ ^[0-9]+$ ]] || return 1
  (( w > 0 && h > 0 )) || return 1
  (( w <= IMAGE_MAX_DIM && h <= IMAGE_MAX_DIM )) || return 1
  (( w * h <= IMAGE_MAX_PIXELS )) || return 1
  return 0
}

cmd_page() {
  local dir=$1 url=$2 id=$3
  resolve_cache_dir "$dir" || { emit false "$id" "" "" "" "" 0 "unusable cache directory"; return 0; }
  is_http_url "$url" || { emit false "$id" "" "" "" "" 0 "not an http url"; return 0; }

  local html
  html=$(fetch_head "$url")
  [[ -n $html ]] || { emit false "$id" "" "" "" "" 0 "page unreachable"; return 0; }

  local image video site
  image=$(unescape "$(meta_content "$html" 'og:image')")
  [[ -z $image ]] && image=$(unescape "$(meta_content "$html" 'og:image:url')")
  [[ -z $image ]] && image=$(unescape "$(meta_content "$html" 'twitter:image')")
  [[ -z $image ]] && image=$(unescape "$(meta_content "$html" 'twitter:image:src')")
  video=$(unescape "$(meta_content "$html" 'og:video:secure_url')")
  [[ -z $video ]] && video=$(unescape "$(meta_content "$html" 'og:video:url')")
  [[ -z $video ]] && video=$(unescape "$(meta_content "$html" 'og:video')")
  site=$(unescape "$(meta_content "$html" 'og:site_name')")

  image=$(absolutize "$image" "$url")
  video=$(absolutize "$video" "$url")
  is_http_url "$image" || image=""
  is_http_url "$video" || video=""

  if [[ -z $image ]]; then
    emit false "$id" "" "$video" "$site" "" 0 "no artwork on the page"
    return 0
  fi

  local path bytes=0
  path=$(download_image "$image") || path=""
  [[ -n $path ]] && bytes=$(file_size "$path")
  if [[ -z $path ]]; then
    emit false "$id" "$image" "$video" "$site" "" 0 "artwork could not be downloaded"
    return 0
  fi
  emit true "$id" "$image" "$video" "$site" "$path" "$bytes" ""
}

cmd_image() {
  local dir=$1 url=$2 id=$3
  resolve_cache_dir "$dir" || { emit false "$id" "" "" "" "" 0 "unusable cache directory"; return 0; }
  local path bytes=0
  path=$(download_image "$url") || path=""
  if [[ -z $path ]]; then
    emit false "$id" "$url" "" "" "" 0 "artwork could not be downloaded"
    return 0
  fi
  bytes=$(file_size "$path")
  emit true "$id" "$url" "" "" "$path" "$bytes" ""
}

# Deletes only paths that resolve inside the cache directory. The guard is
# against the cache index itself being wrong, not only against a hostile one:
# a bug upstream that put "/" in an artwork field should cost nothing.
cmd_gc() {
  local dir=$1
  shift
  resolve_cache_dir "$dir" || { printf '{"ok":false,"deleted":0,"bytes":0}\n'; return 0; }
  local deleted=0 freed=0 line real
  # Paths come on argv when the caller knows them (the common case, straight
  # from the cache index) and on stdin when the list is too long to pass there.
  gc_one() {
    local line=$1 real
    [[ -n $line ]] || return 0
    [[ $line == /* ]] || return 0
    [[ $line == *".."* ]] && return 0
    [[ -f $line ]] || return 0
    real=$(cd -- "$(dirname -- "$line")" 2>/dev/null && pwd -P)/$(basename -- "$line")
    [[ $real == "$CACHE_DIR"/* ]] || return 0
    freed=$(( freed + $(file_size "$real") ))
    rm -f -- "$real" 2>/dev/null && deleted=$(( deleted + 1 ))
  }
  if [[ $# -gt 0 ]]; then
    for line in "$@"; do gc_one "$line"; done
    printf '{"ok":true,"deleted":%s,"bytes":%s}\n' "$deleted" "$freed"
    return 0
  fi
  while IFS= read -r line; do
    gc_one "$line"
  done
  printf '{"ok":true,"deleted":%s,"bytes":%s}\n' "$deleted" "$freed"
}

# Fetch a feed body, bounded before it can reach the shell.
#
# This exists because QML's XMLHttpRequest offers no way to cap a response. It
# buffers whatever arrives into the process that also draws the desktop, and a
# ceiling enforced by watching that buffer is reactive by construction: between
# any two observations a fast producer has already allocated whatever it liked.
# The bound has to sit on the producer side of the transfer, which means curl.
#
# Two limits, because they fail in different directions. --max-filesize refuses
# a transfer whose declared length is already too large, before a byte of body
# is written. `head -c` covers the case that declaration cannot: a chunked
# response, or an honest-looking header attached to a body that never stops --
# head closes the pipe at the ceiling and curl dies of SIGPIPE. Either way the
# shell is handed a bounded string.
#
# The body goes to stdout and one line of JSON metadata to stderr, so the two
# never have to be disentangled from a single stream.
cmd_feed() {
  local url=$1
  if ! is_http_url "$url"; then
    printf '{"http":0,"error":"not an http url"}\n' >&2
    return 0
  fi

  # curl's own stdout is the body and goes through head; %{stderr} in the
  # write-out format puts the metadata on stderr, so the two streams separate
  # themselves and neither needs parsing out of the other.
  curl --silent --location --max-redirs 5 \
       --connect-timeout "$CONNECT_TIMEOUT" --max-time "$TOTAL_TIMEOUT" \
       --user-agent 'omarchy-news/1.0 (+quickshell)' \
       --header 'Accept: application/rss+xml, application/atom+xml, application/xml, application/json;q=0.9, text/xml;q=0.8, */*;q=0.5' \
       --proto '=http,https' \
       --max-filesize "$FEED_MAX_BYTES" \
       --write-out '%{stderr}{"http":%{http_code},"size":%{size_download},"exit":%{exitcode}}' \
       "$url" | head -c "$FEED_MAX_BYTES"
  # A truncated body means head shut the pipe and curl took SIGPIPE before it
  # could report anything, so the caller treats a body at the ceiling as
  # oversize regardless of what metadata did or did not arrive.
  return 0
}

# Inventory, so the caller can tell which pictures on disk no story claims any
# more and how much space the cache is actually using.
cmd_list() {
  local dir=$1
  resolve_cache_dir "$dir" || { printf '{"ok":false,"files":[],"bytes":0}\n'; return 0; }
  local first=1 total=0 size f
  printf '{"ok":true,"files":['
  while IFS= read -r -d '' f; do
    size=$(file_size "$f")
    total=$(( total + size ))
    [[ $first -eq 1 ]] || printf ','
    first=0
    printf '{"path":"%s","bytes":%s}' "$(json_escape "$f")" "$size"
  done < <(find "$CACHE_DIR" -maxdepth 1 -type f ! -name '.tmp.*' -print0 2>/dev/null)
  printf '],"bytes":%s}\n' "$total"
}

# Read a local OPML file for import. Same contract as cmd_feed: the body on
# stdout, one line of JSON metadata on stderr. The path is the user's own
# choice, so it may point anywhere they can read -- but only regular files are
# read, and never more than OPML_MAX_BYTES of them, so pointing it at
# /dev/zero or a multi-gigabyte log costs nothing.
cmd_opml() {
  local path=$1
  [[ $path == "~" ]] && path=$HOME
  [[ $path == "~/"* ]] && path=$HOME/${path#"~/"}
  [[ $path == file://* ]] && path=${path#file://}
  if [[ -z $path || $path != /* ]]; then
    printf '{"ok":false,"error":"enter an absolute path (or one starting with ~/)"}\n' >&2; return 0
  fi
  if [[ ! -e $path ]]; then
    printf '{"ok":false,"error":"no such file"}\n' >&2; return 0
  fi
  if [[ ! -f $path || ! -r $path ]]; then
    printf '{"ok":false,"error":"not a readable file"}\n' >&2; return 0
  fi
  local size
  size=$(file_size "$path")
  if (( size > OPML_MAX_BYTES )); then
    printf '{"ok":false,"error":"file is larger than 2 MB"}\n' >&2; return 0
  fi
  head -c "$OPML_MAX_BYTES" -- "$path"
  printf '{"ok":true,"path":"%s","size":%s}\n' "$(json_escape "$path")" "$size" >&2
}

# A file chooser, when one is installed. Prints the chosen path, or nothing if
# the user cancelled or no chooser exists; the caller falls back to the typed
# path either way.
cmd_pick() {
  local start=${HOME:-/}/
  if command -v zenity >/dev/null 2>&1; then
    zenity --file-selection --title='Import OPML' --filename="$start" \
           --file-filter='OPML (*.opml *.xml) | *.opml *.OPML *.xml *.XML' \
           --file-filter='All files | *' 2>/dev/null
  elif command -v kdialog >/dev/null 2>&1; then
    kdialog --title 'Import OPML' --getopenfilename "$start" 'OPML (*.opml *.xml)' 2>/dev/null
  else
    printf '{"ok":false,"error":"no file chooser installed (zenity or kdialog); type the path instead"}\n' >&2
  fi
  return 0
}

main() {
  local cmd=${1-}
  case $cmd in
    page)  [[ $# -eq 4 ]] || { emit false "" "" "" "" "" 0 "usage: news-media page <dir> <url> <id>"; exit 0; }
           cmd_page "$2" "$3" "$4" ;;
    image) [[ $# -eq 4 ]] || { emit false "" "" "" "" "" 0 "usage: news-media image <dir> <url> <id>"; exit 0; }
           cmd_image "$2" "$3" "$4" ;;
    feed)  [[ $# -eq 2 ]] || { printf '{"http":0,"error":"usage: news-media feed <url>"}\n' >&2; exit 0; }
           cmd_feed "$2" ;;
    list)  [[ $# -eq 2 ]] || { printf '{"ok":false,"files":[],"bytes":0}\n'; exit 0; }
           cmd_list "$2" ;;
    gc)    [[ $# -ge 2 ]] || { printf '{"ok":false,"deleted":0,"bytes":0}\n'; exit 0; }
           shift
           cmd_gc "$@" ;;
    opml)  [[ $# -eq 2 ]] || { printf '{"ok":false,"error":"usage: news-media opml <path>"}\n' >&2; exit 0; }
           cmd_opml "$2" ;;
    pick)  cmd_pick ;;
    *)     emit false "" "" "" "" "" 0 "unknown command" ;;
  esac
}

main "$@"
